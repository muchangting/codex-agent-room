{
  "name": "codex-agent-room",
  "version": "0.2.0",
  "description": "An embedded multi-agent group chat for Codex, with real Gemini task handoffs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "files": [
    "src",
    "dist",
    "vendor",
    "skills",
    ".codex-plugin",
    "LICENSE",
    "NOTICE",
    "README.md",
    "scripts/install.mjs",
    "scripts/build.mjs",
    "docs",
    "marketplace.json",
    ".agents/plugins/marketplace.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "setup": "node scripts/install.mjs",
    "prepack": "npm run build",
    "format": "prettier --write src scripts test package.json marketplace.json .codex-plugin/plugin.json",
    "format:check": "prettier --check src scripts test package.json marketplace.json .codex-plugin/plugin.json"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^11.8.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2"
  }
}
